DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trp
DB_CREATE_IF_MISSING=true

ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=ChangeMe!123
ADMIN_FULL_NAME=System Administrator

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
OTP_EXPIRE_MINUTES=10
# Optional — Fernet key for encrypting sensitive fields (e.g. bank details).
# If unset, a key is derived from SECRET_KEY; set this explicitly in production.
ENCRYPTION_KEY=

# Comma-separated; include both if devs use localhost and 127.0.0.1 interchangeably.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

TRAVEL_TICKET_STORAGE_DIR=storage/travel_tickets
TRAVEL_REQUEST_MIN_LEAD_WORKING_DAYS=2

# Optional — invoice upload uses Gemini when set (otherwise deterministic demo extraction).
GEMINI_API_KEY=
GEMINI_INVOICE_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_INVOICE_MODEL_FALLBACK=gemini-2.5-pro

# Transactional Email Notification System (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
